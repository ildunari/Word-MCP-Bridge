{
  "name": "word-mcp-bridge",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ildunari/Word-MCP-Bridge.git"
  },
  "homepage": "https://github.com/ildunari/Word-MCP-Bridge",
  "bugs": {
    "url": "https://github.com/ildunari/Word-MCP-Bridge/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "bridge": "pnpm --filter @word-mcp-bridge/bridge build && node packages/bridge/dist/cli.js",
    "bridge:serve": "pnpm --filter @word-mcp-bridge/bridge start",
    "bridge:mcp": "pnpm exec office-bridge mcp-serve",
    "bridge:stop": "pnpm exec office-bridge stop",
    "bridge:prepare-nih-lane": "node scripts/bridge/nih-validation.mjs",
    "dev-server:word": "pnpm --filter @word-mcp-bridge/word-addin dev-server",
    "helper:build": "swift build --package-path apps/mac-helper",
    "helper:run": "swift run --package-path apps/mac-helper WordMCPBridgeHelper",
    "package:helper": "bash apps/mac-helper/Scripts/package_app.sh",
    "setup:word": "pnpm --filter @word-mcp-bridge/word-addin exec office-addin-dev-certs install && pnpm --filter @word-mcp-bridge/word-addin exec office-addin-manifest validate manifest.xml && pnpm --filter @word-mcp-bridge/word-addin exec office-addin-manifest validate manifest.prod.xml",
    "package:addin": "node scripts/package-addin.mjs",
    "release:bundle": "pnpm build && node scripts/package-addin.mjs && bash apps/mac-helper/Scripts/package_app.sh && pnpm --filter @word-mcp-bridge/bridge pack:check",
    "start:word": "pnpm --filter @word-mcp-bridge/word-addin start",
    "stop:word": "pnpm --filter @word-mcp-bridge/word-addin stop"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@word-mcp-bridge/bridge": "workspace:*",
    "@types/node": "^25.1.0",
    "happy-dom": "^20.8.4",
    "svelte-check": "^4.4.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
